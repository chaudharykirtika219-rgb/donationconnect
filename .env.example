# Copy to .env.local (git-ignored). Leave the Supabase values empty to run the labelled DEMO mode
# (browser-only fictional data). Fill BOTH to use your Supabase project.
#
# Supabase → Project Settings → API:
#   Project URL                       → VITE_SUPABASE_URL
#   anon / publishable key (public)   → VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to "true" ONLY after you have configured an SMS provider in Supabase Auth → Providers → Phone
# and tested that a code arrives. Until then the app hides phone sign-in and says SMS isn't configured.
VITE_SUPABASE_PHONE_AUTH=false

# Must match Supabase Auth → "Confirm email". Default (unset/true): sign-up waits for the confirmation link.
VITE_SUPABASE_EMAIL_CONFIRM=true

# Optional: Mapbox PUBLIC token (pk.…) for real maps on organisation pages.
VITE_MAPBOX_TOKEN=

# NEVER put the service-role key, "sb_secret_…" keys, SMS or email provider secrets here.
# Every VITE_ variable is shipped to the browser. The app refuses to start if it detects a service-role key.
